{
  // Cloudflare Workers static assets. This site is a Next.js static export
  // (next.config.ts sets output: "export"), so there is no server runtime and
  // no OpenNext adapter: `next build` writes out/ and Wrangler uploads it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "./worker.js",
  "compatibility_date": "2026-11-03",
  "assets": {
    // Next.js emits out/about.html (not out/about/index.html) because
    // trailingSlash is false, so auto-trailing-slash is the matching mode.
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Run the Worker first so the www -> apex redirect applies to cached
    // asset paths (like /) instead of being bypassed by the asset cache.
    "run_worker_first": true
  },
  // Keep the custom domain attached on every deploy. Without this, a deploy
  // that runs in a fresh environment (CI) can leave stevenkoehl.com detached
  // and fall back to the registrar's parking page.
  "routes": [
    { "pattern": "stevenkoehl.com", "custom_domain": true },
    { "pattern": "www.stevenkoehl.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  // Keep the workers.dev subdomain available for previews/debugging.
  "workers_dev": true,
  "preview_urls": true
}
